{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Home Assistant",
      "type": "debugpy",
      "request": "launch",
      "module": "homeassistant",
      "subProcess": false,
      "justMyCode": false,
      "args": [
        "--debug",
        "-c",
        "config"
      ]
    },
    {
      "name": "Home Assistant 2026.6.4 (Python 3.14.5)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.ha-envs/2026.6.4/bin/python",
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/.ha-envs/2026.6.4",
        "UV_PYTHON": "${workspaceFolder}/.ha-envs/2026.6.4/bin/python",
        "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.ha-envs/2026.6.4",
        "UV_NO_CONFIG": "1"
      },
      "module": "homeassistant",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Prepare HA 2026.6.4",
      "subProcess": false,
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "--debug",
        "-c",
        "${workspaceFolder}/config/versions/2026.6.4"
      ]
    },
    {
      "name": "Home Assistant 2025.12.4 (Python 3.13.7)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.ha-envs/2025.12.4/bin/python",
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/.ha-envs/2025.12.4",
        "UV_PYTHON": "${workspaceFolder}/.ha-envs/2025.12.4/bin/python",
        "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.ha-envs/2025.12.4",
        "UV_NO_CONFIG": "1"
      },
      "module": "homeassistant",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Prepare HA 2025.12.4",
      "subProcess": false,
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "--debug",
        "-c",
        "${workspaceFolder}/config/versions/2025.12.4"
      ]
    }
  ]
}